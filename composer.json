{
    "name": "wazi/skeleton",
    "description": "Le projet de départ de Wazi : un site de plusieurs pages, prêt à modifier.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/wazi-php/wazi",
    "support": {
        "issues": "https://github.com/wazi-php/wazi-skeleton/issues",
        "source": "https://github.com/wazi-php/wazi-skeleton",
        "docs": "https://github.com/wazi-php/wazi/blob/main/docs/README.md"
    },
    "authors": [
        {
            "name": "René MUMBA KIBUTIKA",
            "homepage": "https://github.com/Doe243"
        }
    ],
    "keywords": [
        "wazi",
        "skeleton",
        "framework",
        "php"
    ],
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "wazi/framework": "^0.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php wazi db:migrate"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
