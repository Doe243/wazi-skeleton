#!/usr/bin/env php
<?php

/**
 * La console de votre projet.
 *
 *     wazi                 la liste des commandes
 *     wazi serve           lance le site sur votre ordinateur
 *     wazi routes          liste les routes de l'application
 *     wazi explain contact --method=POST    explique ce qu'une adresse traverse
 *     wazi make:controller Tarif    crée un contrôleur et sa page
 *     wazi messages        affiche les messages reçus par le formulaire de contact
 *
 * Si la commande « wazi » n'est pas installée sur votre ordinateur, tapez
 * « php wazi » à la place : c'est ce même fichier qui s'exécute.
 *
 * Les commandes de Wazi et les vôtres sont déclarées ici, une par ligne :
 * vous savez toujours d'où vient une commande.
 *
 * Pour écrire la vôtre, copiez src/MessagesCommand.php.
 */

declare(strict_types=1);

use App\Messagerie;
use App\MessagesCommand;
use Wazi\Console\Application;
use Wazi\Console\Command\MakeControllerCommand;
use Wazi\Console\Command\ServeCommand;
use Wazi\Console\Output;
use Wazi\Kernel\Command\ExplainCommand;
use Wazi\Kernel\Command\RoutesCommand;
use Wazi\Kernel\Kernel;

// La console ne s'exécute que dans un terminal, jamais par un navigateur.
if (PHP_SAPI !== 'cli') {
    exit(1);
}

if (!is_file(__DIR__ . '/vendor/autoload.php')) {
    fwrite(STDERR, 'Les bibliothèques ne sont pas installées. Lancez « composer install » dans ce dossier.' . PHP_EOL);

    exit(1);
}

require __DIR__ . '/vendor/autoload.php';

// Votre application, la même que celle que sert le site.
try {
    $app = Kernel::load(__DIR__ . '/app.php');
} catch (Throwable $error) {
    // Une erreur dans app.php (un réglage manquant, une route mal écrite)
    // empêche aussi la console de démarrer : on dit laquelle, et où.
    $output = new Output(STDOUT, STDERR);
    $output->error($error->getMessage());
    $output->line('  ' . $error::class . ', dans ' . $error->getFile() . ', ligne ' . $error->getLine());

    exit(1);
}

$console = new Application();

// Les commandes de Wazi.
$console->add(new ServeCommand(__DIR__));
$console->add(new RoutesCommand($app->router));
$console->add(new ExplainCommand($app));
$console->add(new MakeControllerCommand(__DIR__));

// Les commandes de votre projet. Le conteneur fabrique leurs services,
// comme il le fait pour vos contrôleurs.
$console->add(new MessagesCommand($app->container->get(Messagerie::class)));

exit($console->run($argv));
