<!-- La mise en page : le squelette commun à toutes les pages du site.
     Chaque page s'y place par <k:layout name="base">, et remplit les emplacements <k:block>.

     « site », « annee » et « message » ne sont passés par aucun contrôleur :
     app.php les partage avec tous les templates.

     « page » est donné par chaque contrôleur : c'est le nom de la page affichée,
     qui sert à marquer son lien dans le menu.

     Ces commentaires sont pour vous : Kioo ne les envoie jamais au visiteur. -->
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><k:block name="titre">Accueil</k:block> — {site}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/app.css">
    <!-- Le thème clair ou sombre choisi par le visiteur : voir public/theme.js.
         Wazi n'accepte que les scripts servis par votre site. -->
    <script src="/theme.js"></script>
</head>
<body>
<header class="bandeau">
    <div class="conteneur">
        <a class="marque" href="/">
            <!-- Le signe de Wazi : deux panneaux de verre qui forment un W. Remplacez
                 ce dessin et le nom (APP_NAME, dans .env) par les vôtres.
                 Ses couleurs viennent de app.css : il suit le thème clair ou sombre.
                 aria-hidden : il n'apprend rien à un lecteur d'écran, le nom est juste à côté. -->
            <svg viewBox="0 0 76 56" fill="none" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path class="panneau" d="M6 8 L24 48 L40 14"/>
                <path class="panneau clair" d="M36 14 L52 48 L70 8"/>
            </svg>
            {site}
        </a>
        <!-- aria-current="page" marque le lien de la page affichée. Quand la valeur
             est null, Kioo retire l'attribut. -->
        <div class="navigation">
            <nav class="menu" aria-label="Navigation principale">
                <a href="/" aria-current="{(page ?? '') == 'accueil' ? 'page' : null}">Accueil</a>
                <a href="/a-propos" aria-current="{(page ?? '') == 'a-propos' ? 'page' : null}">À propos</a>
                <a href="/contact" aria-current="{(page ?? '') == 'contact' ? 'page' : null}">Contact</a>
            </nav>

            <!-- Caché tant que le script n'est pas chargé : sans JavaScript, le
                 thème suit simplement le réglage de l'appareil. -->
            <button type="button" class="bouton-theme" id="theme" hidden aria-label="Changer de thème, clair ou sombre">
                <svg class="lune" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
                <svg class="soleil" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></svg>
            </button>
        </div>
    </div>
</header>

<main class="conteneur">
    <!-- Le message laissé par la page précédente, s'il y en a un. -->
    <p k:if="message" class="message succes" role="status">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9"/></svg>
        {message}
    </p>

    <k:block name="content"></k:block>
</main>

<k:include file="partiels/pied">
</body>
</html>
